{
  "files.watcherExclude": {
    "**/.git/objects/**": true,
    "**/.git/subtree-cache/**": true,
    "**/node_modules/*/**": true,
    "**/venv/**": true,
    "**/.venv/**": true,
    "**/__pycache__/**": true
  },
  "search.exclude": {
    "**/venv": true,
    "**/.venv": true,
    "**/__pycache__": true
  },
  "python.defaultInterpreterPath": "${workspaceFolder}/venv/Scripts/python.exe"
}
